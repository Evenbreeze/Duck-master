UVICORN_HOST = "0.0.0.0"
UVICORN_PORT = 8000

# 持久化到 /var/lib/marzban 卷（force-recreate 容器时不会丢管理员/用户数据）
SQLALCHEMY_DATABASE_URL = "sqlite:////var/lib/marzban/db.sqlite3"

UVICORN_SSL_CERTFILE = "/var/lib/marzban/certs/__DOMAIN__.cer"
UVICORN_SSL_KEYFILE = "/var/lib/marzban/certs/__DOMAIN__.cer.key"
UVICORN_SSL_CA_TYPE = "public"

XRAY_JSON = "/var/lib/marzban/xray_config.json"
XRAY_MAIN_PANEL_ONLY = true

XRAY_SUBSCRIPTION_URL_PREFIX = "https://__DOMAIN__:8000"
XRAY_SUBSCRIPTION_PATH = "sub"

PANEL_NAME = "Duck"
DASHBOARD_PATH = "/dashboard/"

SUB_PROFILE_TITLE = "Duck"
SUB_UPDATE_INTERVAL = 12

# v2rayN 默认用 base64 链接；true 时 6.40+ 走 JSON，易出现类型 Custom / 端口 0
USE_CUSTOM_JSON_DEFAULT = false

# 主控模板入站默认口（供克隆节点入站）；节点实际端口在面板「节点」里 per-node 分配
DUCK_INBOUND_PORT_VLESS = __PORT_VLESS__
DUCK_INBOUND_PORT_VMESS = __PORT_VMESS__
DUCK_INBOUND_PORT_TROJAN = __PORT_TROJAN__
DUCK_INBOUND_PORT_SS = __PORT_SS__

# Telegram 请在面板「菜单 → Telegram 通知」填写，保存后 duck restart
